{
  "name": "sato",
  "version": "0.0.0",
  "type": "module",
  "description": "A local-first, evidence-grounded personal tutor powered by Pi",
  "license": "MIT",
  "bin": {
    "learn": "apps/cli/src/index.ts"
  },
  "files": ["apps/", "packages/", "resources/", "docs/", "scripts/", "README.md", "LICENSE"],
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun apps/cli/src/index.ts",
    "smoke": "bun apps/cli/src/index.ts --smoke",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check:publication": "bun scripts/check-publication.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  }
}
